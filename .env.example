# Vorlage. Kopieren nach .env und Werte setzen:  cp .env.example .env
# .env ist in .gitignore und darf nie ins Repo.
#
# Wird gelesen von:
#   - docker compose (automatisch aus dem Projektordner, oder per --env-file)
#   - der App bei mvn spring-boot:run (spring.config.import)

POSTGRES_DB=blickwinkel
POSTGRES_USER=blickwinkel
POSTGRES_PASSWORD=bitte-aendern
